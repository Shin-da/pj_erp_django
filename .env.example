# Copy to .env (or export these before running manage.py) — never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-real-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production (DigitalOcean): https://your-app.ondigitalocean.app
# CSRF_TRUSTED_ORIGINS=https://your-app.ondigitalocean.app
DJANGO_TIME_ZONE=Asia/Manila

# --- Database ---------------------------------------------------------------
# DigitalOcean App Platform / Managed Postgres: set DATABASE_URL (ssl required).
# When DATABASE_URL is set, the local DJANGO_DB_PROFILE / DB_NAME_* block is ignored.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:25060/DEFDB?sslmode=require
# DB_SSLMODE=require
#
# Local dual catalogs (no DATABASE_URL):
# Flip DJANGO_DB_PROFILE to switch catalogs. Restart runserver after changing it.
#   dev  = pj_erp_dev   working copy (mutate freely)
#   prod = pj_erp_prod  frozen snapshot of the FTP MSSQL dump (local Postgres, not live tag11.in)
DJANGO_DB_PROFILE=dev
DB_NAME_DEV=pj_erp_dev
DB_NAME_PROD=pj_erp_prod
DB_USER=pj_dev
DB_PASSWORD=pj_dev_local
DB_HOST=localhost
DB_PORT=5432

# Optional. Only needed once, to create catalogs / grant CREATEDB. Not used by Django.
# PG_SUPERUSER_PASSWORD=

# MSSQL script dump from the FTP copy (schema + INSERTs). Used by import_mssql_snapshot.
LEGACY_SQL_DUMP=C:/Users/Matt/ftp_perfect-jewel-active-sync/iadmin/stock_rfid_backup.sql

# --- Production media (Cloudflare R2, DigitalOcean Spaces, or AWS S3) -------
# Leave AWS_STORAGE_BUCKET_NAME empty for local FileSystemStorage (dev).
# After enabling Spaces/R2, push existing local files once with:
#   python manage.py upload_local_media
#
# DigitalOcean Spaces example:
#   AWS_STORAGE_BUCKET_NAME=pj-erp-media
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_S3_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com
#   AWS_S3_REGION_NAME=sgp1
#   AWS_S3_CUSTOM_DOMAIN=pj-erp-media.sgp1.digitaloceanspaces.com
#   AWS_QUERYSTRING_AUTH=False
#
# Cloudflare R2 example:
#   AWS_STORAGE_BUCKET_NAME=pj-erp-media
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   AWS_S3_REGION_NAME=auto
#   AWS_S3_CUSTOM_DOMAIN=media.yourdomain.com
#   AWS_QUERYSTRING_AUTH=False
#
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=
# AWS_QUERYSTRING_AUTH=False
# SERVE_MEDIA=   # default: on when not using S3; set False behind nginx media alias
#
# Product photo upload caps (catalogue /products/photos/):
# PRODUCT_PHOTO_MAX_WIDTH=0              # 0 = keep full camera file; set e.g. 2400 to downscale
# PRODUCT_PHOTO_JPEG_QUALITY=88          # only used when MAX_WIDTH > 0
# PRODUCT_PHOTO_MAX_UPLOAD_BYTES=104857600   # 100 MB per file
# DATA_UPLOAD_MAX_MEMORY_SIZE=230686720      # whole POST body (bulk drops)
# FILE_UPLOAD_MAX_MEMORY_SIZE=20971520       # per-file RAM before temp disk

