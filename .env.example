# Copy to .env (or export these before running manage.py) — never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-real-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Manila

# Flip this to switch catalogs. Restart runserver after changing it.
#   dev  = pj_erp_dev   working copy (mutate freely)
#   prod = pj_erp_prod  frozen snapshot of the FTP MSSQL dump (local Postgres, not live tag11.in)
DJANGO_DB_PROFILE=dev
DB_NAME_DEV=pj_erp_dev
DB_NAME_PROD=pj_erp_prod
DB_USER=pj_dev
DB_PASSWORD=pj_dev_local
DB_HOST=localhost
DB_PORT=5432

# Optional. Only needed once, to create catalogs / grant CREATEDB. Not used by Django.
# PG_SUPERUSER_PASSWORD=

# MSSQL script dump from the FTP copy (schema + INSERTs). Used by import_mssql_snapshot.
LEGACY_SQL_DUMP=C:/Users/Matt/ftp_perfect-jewel-active-sync/iadmin/stock_rfid_backup.sql
